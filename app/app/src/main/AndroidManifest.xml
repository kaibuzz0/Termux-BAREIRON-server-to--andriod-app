<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bareiron.game">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".BareironApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Bareiron"
        android:usesCleartextTraffic="true">

        <!-- MAIN MENU (Launcher) -->
        <activity
            android:name=".MainMenuActivity"
            android:exported="true"
            android:theme="@style/Theme.Bareiron.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SINGLE PLAYER LAUNCHER -->
        <activity android:name=".SinglePlayerLauncherActivity" />
        <activity
            android:name=".GameActivity"
            android:theme="@style/Theme.Bareiron.NoActionBar"
            android:screenOrientation="landscape" />

        <!-- CONNECTIVITY -->
        <activity android:name=".ServerBrowserActivity" />
        <activity android:name=".ServerConnectActivity" />

        <!-- SOCIAL -->
        <activity android:name=".FriendsActivity" />
        <activity android:name=".ProfileActivity" />

        <!-- CONTENT -->
        <activity android:name=".ContentManagerActivity" />
        <activity android:name=".StoreActivity" />
        <activity android:name=".PackPreviewActivity" />

        <!-- LEGACY -->
        <activity android:name=".MainActivity" />
        <activity android:name=".RealmViewerActivity" />
        <activity android:name=".AddonBrowserActivity" />
        <activity android:name=".SettingsActivity" />

    </application>

</manifest>
