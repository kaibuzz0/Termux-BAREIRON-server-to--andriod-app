<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bareiron.game">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BareironApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Bareiron"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainMenuActivity"
            android:exported="true"
            android:theme="@style/Theme.Bareiron.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BareironServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local multiplayer game server that must remain reachable while the host app is backgrounded" />
        </service>

        <!-- Existing prototype client/content screens retained during migration. -->
        <activity android:name=".SinglePlayerLauncherActivity" />
        <activity
            android:name=".GameActivity"
            android:theme="@style/Theme.Bareiron.NoActionBar"
            android:screenOrientation="landscape" />
        <activity android:name=".ServerBrowserActivity" />
        <activity android:name=".ServerConnectActivity" />
        <activity android:name=".FriendsActivity" />
        <activity android:name=".ProfileActivity" />
        <activity android:name=".ContentManagerActivity" />
        <activity android:name=".StoreActivity" />
        <activity android:name=".PackPreviewActivity" />
        <activity android:name=".MainActivity" />
        <activity android:name=".RealmViewerActivity" />
        <activity android:name=".AddonBrowserActivity" />
        <activity android:name=".SettingsActivity" />

    </application>

</manifest>
