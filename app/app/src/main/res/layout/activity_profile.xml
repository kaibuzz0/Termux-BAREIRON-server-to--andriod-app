<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👤 PROFILE"
        android:textColor="#FF9800"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingBottom="24dp" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Player"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tvKills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧟 Zombies Killed: 0"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:paddingVertical="8dp" />

    <TextView
        android:id="@+id/tvWaves"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌊 Highest Wave: 0"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:paddingVertical="8dp" />

    <TextView
        android:id="@+id/tvBosses"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👹 Bosses Defeated: 0"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:paddingVertical="8dp" />

    <TextView
        android:id="@+id/tvQuests"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📜 Quests Completed: 0"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:paddingVertical="8dp" />

    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏆 Total Score: 0"
        android:textColor="#FFEB3B"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingVertical="8dp" />

    <TextView
        android:id="@+id/tvPlaytime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏱️ Play Time: 0 min"
        android:textColor="#888888"
        android:textSize="14sp"
        android:paddingVertical="8dp" />

</LinearLayout>
